# Keep the real file outside the repository, with owner-only read permission.
PORT=8317
ALLOCATION_MODEL_BASE_URL=https://api.deepseek.com
ALLOCATION_MODEL=deepseek-flash
ALLOCATION_MODEL_API_KEY=your-api-key
# Optional local corpus, supplied by its authorized owner.
QIZHULOU_ROOT=/absolute/path/to/qizhulou-mcp
QIZHULOU_DB=/absolute/path/to/qizhulou-mcp/data/index.sqlite
QIZHULOU_PYTHON=/absolute/path/to/qizhulou-mcp/.venv/bin/python
QIZHULOU_RETRIEVAL_MODE=keyword
# Protected deployment under an existing website path.
# Configure all three together when publishing.
# ALLOCATION_PUBLIC_ORIGIN=https://example.com
# ALLOCATION_BASE_PATH=/finance/allocation/
# ALLOCATION_AUTH_URL=https://example.com/tools/api/auth/check
# ALLOCATION_DAILY_REQUEST_LIMIT=100
# ALLOCATION_QUOTA_FILE=/path/to/private/question-quota.json
